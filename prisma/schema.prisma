generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  slug          String?   @unique
  name          String
  cpf           String?   @unique
  avatar        String?
  image         String?
  emailVerified DateTime?
  role          Role      @default(READER)
  bio           String?   @db.Text
  columnTitle   String?
  displayOrder  Int       @default(0)
  social        Json?
  passwordHash  String?
  twoFA         Boolean   @default(false)
  twoFASecret   String?
  city          String?
  state         String?   @default("MS")
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())

  articles      Article[] @relation("Authors")
  comments      Comment[]
  savedArticles SavedArticle[]
  subscription  Subscription?
  sessions      Session[]
  accounts      Account[]
  auditLogs     AuditLog[]
  articleVersions ArticleVersion[]
  pollVotes     PollVote[]
}

enum Role {
  SUPER_ADMIN
  EDITOR_CHIEF
  SECTION_EDITOR
  REPORTER
  COLUMNIST
  MODERATOR
  FINANCE
  READER
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

model Article {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  eyebrow             String?
  lead                String?  @db.Text
  body                Json
  heroImage           String?
  heroCaption         String?
  authors             User[]   @relation("Authors")
  sectionId           String
  section             Section  @relation(fields: [sectionId], references: [id])
  seriesId            String?
  series              Series?  @relation(fields: [seriesId], references: [id])
  tags                Tag[]
  status              ArticleStatus @default(DRAFT)
  publishedAt         DateTime?
  scheduledAt         DateTime?
  allowComments       Boolean  @default(true)
  paywall             Boolean  @default(false)
  sendPush            Boolean  @default(false)
  includeInNewsletter Boolean  @default(true)
  sourceUrl           String?
  views               Int      @default(0)
  readTimeMin         Int?
  comments            Comment[]
  saves               SavedArticle[]
  versions            ArticleVersion[]
  viewDays            ArticleViewDaily[]
  viewEvents          ArticleViewEvent[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([sectionId])
}

model ArticleViewDaily {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  date      DateTime
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, date])
  @@index([date, views])
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model ArticleVersion {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  body      Json
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Section {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  parentId    String?
  showInMenu  Boolean   @default(false)
  menuOrder   Int       @default(0)
  articles    Article[]
  rssFeeds    RSSFeed[]
}

model Series {
  id         String    @id @default(cuid())
  name       String
  parts      Int
  totalParts Int
  articles   Article[]
}

model Tag {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  articles Article[]
}

model Comment {
  id         String        @id @default(cuid())
  articleId  String
  article    Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?         @relation(fields: [userId], references: [id])
  guestName  String?
  body       String        @db.Text
  status     CommentStatus @default(PENDING)
  flags      Int           @default(0)
  votes      Int           @default(0)
  parentId   String?
  parent     Comment?      @relation("Replies", fields: [parentId], references: [id])
  replies    Comment[]     @relation("Replies")
  ip         String?
  userAgent  String?
  flagReason String?
  createdAt  DateTime      @default(now())

  @@index([status, createdAt])
}

enum CommentStatus {
  PENDING
  APPROVED
  HIDDEN
  SPAM
  BANNED
}

model SavedArticle {
  userId    String
  articleId String
  user      User    @relation(fields: [userId], references: [id])
  article   Article @relation(fields: [articleId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, articleId])
}

model Subscription {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  plan         Plan
  amount       Int
  status       SubStatus     @default(ACTIVE)
  method       PaymentMethod
  externalId   String?
  startedAt    DateTime      @default(now())
  cancelledAt  DateTime?
  transactions Transaction[]
}

enum Plan {
  READER
  SUPPORTER
  GUARDIAN
  PATRON
  CUSTOM
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
}

enum PaymentMethod {
  PIX
  CARD
  BOLETO
}

model Transaction {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  amount         Int
  method         PaymentMethod
  status         TxStatus
  externalId     String?
  receiptUrl     String?
  createdAt      DateTime      @default(now())
}

enum TxStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  client      String
  slot        String
  creative    String
  targetUrl   String   @default("")
  impressions Int      @default(0)
  clicks      Int      @default(0)
  weight      Int      @default(1)
  effects     String   @default("fadeIn,pulse,shimmer")
  startsAt    DateTime
  endsAt      DateTime
  status      CampaignStatus @default(ACTIVE)
  events      AdEvent[]
}

model AdEvent {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type       String
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

model AdSlot {
  id         String @id @default(cuid())
  name       String
  dimensions String
  page       String
  position   String
}

model Newsletter {
  id          String                 @id @default(cuid())
  name        String
  slug        String                 @unique
  description String                 @db.Text
  sentAt      DateTime?
  subscribers NewsletterSubscriber[]
}

model NewsletterSubscriber {
  id           String     @id @default(cuid())
  email        String
  newsletterId String
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id])
  confirmed    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([email, newsletterId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  target    String?
  ip        String?
  status    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model EditorialAudit {
  id              String               @id @default(cuid())
  title           String
  scope           String?
  summary         String               @db.Text
  status          EditorialAuditStatus @default(PLANNED)
  owner           String?
  dueDate         DateTime?
  completedAt     DateTime?
  evidenceUrl     String?
  findings        String?              @db.Text
  recommendations String?              @db.Text
  createdById     String?
  updatedById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, dueDate])
  @@index([createdAt])
}

enum EditorialAuditStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Tip {
  id            String    @id @default(cuid())
  name          String?
  email         String?
  content       String    @db.Text
  attachments   String[]  @default([])
  status        TipStatus @default(NEW)
  internalNotes String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
}

enum TipStatus {
  NEW
  INVESTIGATING
  PUBLISHED
  ARCHIVED
}

model MarketIndicator {
  key                  String    @id // ex: 'boi', 'soja', 'usd'
  label                String?   // ex: 'Arroba do Boi'
  value                String
  unit                 String?   // ex: 'R$/@', 'R$/sc'
  displayOrder         Int       @default(100)
  isActive             Boolean   @default(true)
  showInHeader         Boolean   @default(false)
  showInMobile         Boolean   @default(false)
  sourceType           String    @default("MANUAL") // MANUAL, SYSTEM, JSON_API
  sourceUrl            String?   @db.Text
  sourcePath           String?
  sourceHeaders        String?   @db.Text
  sourceRefreshMinutes Int       @default(60)
  formatDecimals       Int       @default(2)
  prefix               String?
  suffix               String?
  lastFetchStatus      String?
  lastFetchError       String?   @db.Text
  lastFetchedAt        DateTime?
  sourceUpdatedAt      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model AgendaEvent {
  id          String   @id @default(cuid())
  time        String   // "09:00"
  organ       String   // "ALMS", "TJ-MS"
  description String
  date        DateTime @default(now())
  status      String   @default("CONFIRMED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Voice {
  id          String   @id @default(cuid())
  text        String   @db.Text
  tag         String   @default("Bastidores")
  location    String?
  isActive    Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, publishedAt])
}

model Charge {
  id          String   @id @default(cuid())
  imageUrl    String
  caption     String?
  credit      String?
  articleId   String?
  isActive    Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, publishedAt])
}

model SiteSetting {
  key       String   @id // e.g., 'FEATURED_SERIES_ID', 'SOCIAL_FB', etc.
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model PodcastEpisode {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  embedUrl    String?
  audioUrl    String?
  coverImage  String?
  duration    String?  // e.g. "45 min"
  isActive    Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AlertType {
  LIVE
  BREAKING
  INFO
}

model Alert {
  id        String    @id @default(cuid())
  message   String
  link      String?
  type      AlertType @default(INFO)
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SiteMetric {
  id        String   @id @default(cuid())
  date      DateTime @unique @default(now())
  views     Int      @default(0)
  visitors  Int      @default(0)
}

model SiteVisitorDaily {
  id          String   @id @default(cuid())
  date        DateTime
  visitorHash String
  createdAt   DateTime @default(now())

  @@unique([date, visitorHash])
  @@index([date])
}

model ArticleViewEvent {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  referrer    String?
  device      String?
  country     String?
  createdAt   DateTime @default(now())

  @@index([articleId, createdAt])
  @@index([createdAt])
}

model RSSFeed {
  id                  String    @id @default(cuid())
  name                String
  url                 String    @unique
  targetSectionId     String
  targetSection       Section   @relation(fields: [targetSectionId], references: [id])
  autoPublish         Boolean   @default(false)
  requiresReview      Boolean   @default(true)
  lastSync            DateTime?
  isActive            Boolean   @default(true)
  syncIntervalHours   Int       @default(6)
  maxItemsPerSync     Int       @default(10)
  keywordFilter       String[]  @default([])
  blacklistKeywords   String[]  @default([])
  consecutiveFailures Int             @default(0)
  disabledAt          DateTime?
  logs                RSSLog[]
  deadLetters         RSSDeadLetter[]
  createdAt           DateTime        @default(now())
}

enum RSSLogStatus {
  SUCCESS
  FAILED
  PARTIAL
  SKIPPED
}

model RSSLog {
  id           String       @id @default(cuid())
  feedId       String
  feed         RSSFeed      @relation(fields: [feedId], references: [id], onDelete: Cascade)
  articleId    String?      @unique
  status       RSSLogStatus
  message      String?
  itemsTotal   Int          @default(0)
  itemsCreated Int          @default(0)
  itemsSkipped Int          @default(0)
  itemsFailed  Int          @default(0)
  durationMs   Int          @default(0)
  createdAt    DateTime     @default(now())
}

enum PollPlacement {
  SIDEBAR
  ABOVE_FOOTER
  BOTH
}

model Poll {
  id          String        @id @default(cuid())
  question    String
  slug        String        @unique
  expiresAt   DateTime?
  maxVotes    Int?
  placement   PollPlacement @default(SIDEBAR)
  isActive    Boolean       @default(true)
  showResults Boolean       @default(false)
  totalVotes  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  options     PollOption[]
  votes       PollVote[]

  @@index([isActive])
}

model PollOption {
  id           String     @id @default(cuid())
  pollId       String
  poll         Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label        String
  votes        Int        @default(0)
  displayOrder Int        @default(0)

  pollVotes    PollVote[]

  @@index([pollId])
}

model PollVote {
  id          String     @id @default(cuid())
  pollId      String
  poll        Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId    String
  option      PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  fingerprint String
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip          String?
  createdAt   DateTime   @default(now())

  @@unique([pollId, fingerprint])
  @@index([pollId, createdAt])
  @@index([ip, createdAt])
}

model RSSDeadLetter {
  id          String    @id @default(cuid())
  feedId      String
  feed        RSSFeed   @relation(fields: [feedId], references: [id], onDelete: Cascade)
  url         String
  title       String?
  attempts    Int       @default(0)
  lastError   String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([feedId, url])
  @@index([feedId])
}

model FeaturedVideo {
  id           String    @id @default(cuid())
  title        String
  url          String    @db.Text
  embedUrl     String    @db.Text
  platform     String    // "youtube" | "vimeo" | "other"
  thumbnailUrl String?   @db.Text
  description  String?   @db.Text
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, displayOrder])
}
